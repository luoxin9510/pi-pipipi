{
  "name": "pi-pipipi",
  "version": "0.1.0",
  "description": "Claude Code-compatible subagents for pi, exposed as an Agent tool for codemode scripts",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luoxin9510/pi-pipipi.git"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types 'test/real/*.test.ts' 'test/faults/*.test.ts' 'test/panel/*.test.ts' 'test/tui/*.test.ts' 'test/parent/*.test.ts' 'test/worktree/*.test.ts' 'test/memory/*.test.ts'",
    "test:memory": "node --test --experimental-strip-types 'test/memory/*.test.ts'",
    "test:worktree": "node --test --experimental-strip-types 'test/worktree/*.test.ts'",
    "test:parent": "node --test --experimental-strip-types 'test/parent/*.test.ts'",
    "test:real": "node --test --experimental-strip-types 'test/real/*.test.ts'",
    "test:panel": "node --test --experimental-strip-types 'test/panel/*.test.ts'",
    "test:tui": "node --test --experimental-strip-types 'test/tui/*.test.ts'",
    "test:faults": "node --test --experimental-strip-types 'test/faults/*.test.ts'",
    "typecheck": "tsc -p .",
    "eval": "node --experimental-strip-types evals/run.ts",
    "compare": "node --experimental-strip-types evals/compare.ts",
    "stress":"node --experimental-strip-types stress/stress.ts"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.3"
  }
}
